+    Forward(Range<usize>),
+    Reordered(std::vec::IntoIter<usize>),
+}
+
+impl Iterator for GlyphOrder {
+    type Item = usize;
+
+    fn next(&mut self) -> Option<usize> {
+        match self {
+            Self::Forward(range) => range.next(),
+            Self::Reordered(iter) => iter.next(),
