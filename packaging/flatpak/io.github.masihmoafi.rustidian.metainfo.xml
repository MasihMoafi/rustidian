  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Rustidian</name>
  <summary>Native Markdown notebook for local vaults</summary>
  <description>
    <p>Rustidian is a fast, native Markdown notebook for Linux. Your notes stay as plain files in ordinary folders; no account is needed.</p>
    <p>It opens Obsidian-format vaults. It is an independent project and is not affiliated with Obsidian.</p>
    <ul>
      <li>Live, source and reading modes</li>
      <li>Wiki links, backlinks and search</li>
      <li>Tasks, tables, callouts and Mermaid diagrams</li>
      <li>Daily notes, templates, bookmarks and graph views</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.masihmoafi.rustidian.desktop</launchable>
